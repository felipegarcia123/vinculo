# Local only. Create .env with unique, fictional values; never use an operational URL.
DATABASE_URL=postgresql+psycopg://vinculo_local:replace-with-local-only-password@127.0.0.1:55492/vinculo_local?sslmode=disable
VINCULO_DEMO_ONLY=true
AUTH_COOKIE_SECURE=false
AUTH_RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_VINCULO_DEMO_ONLY=true
LOYALTY_INACTIVE_DAYS=30
LOYALTY_LLM_ENABLED=false
LOYALTY_LLM_API_KEY=
VINCULO_ALLOW_LOCAL_SEED=false
VINCULO_OWNER_USERNAME=owner
VINCULO_OWNER_PASSWORD=
VINCULO_CASHIER_USERNAME=cashier
VINCULO_CASHIER_PASSWORD=
VINCULO_CUSTOMER_USERNAME=customer
VINCULO_CUSTOMER_PASSWORD=
